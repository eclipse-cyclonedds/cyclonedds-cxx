module Keyhash_testing {

@final struct KeyAuditBoundedSequence {
    @key sequence<uint32, 2> values;
    uint32 ignored;
};

@final struct KeyAuditUnboundedSequence {
    @key sequence<uint32> values;
};

@final struct KeyAuditString16 {
    @key string<11> value;
};

@final struct KeyAuditString17 {
    @key string<12> value;
};

@final struct KeyAuditSpecExample {
    @key string<12> label;
    @key uint64 id;
};

@bit_bound(8) enum KeyAuditEnum { zero, one, two };

@final struct KeyAuditEnumKey {
    @key KeyAuditEnum value;
    @key uint64 id;
};

@final struct KeyAuditEnumArray {
    @key KeyAuditEnum values[2];
};

@bit_bound(8) bitmask KeyAuditMask { bit_a, bit_b };

@final struct KeyAuditMaskKey {
    @key KeyAuditMask value;
};

@final struct KeyAuditPrimitives {
    @key boolean flag;
    @key char ch;
    @key int16 s;
    @key uint32 u;
    @key float f;
    @key double d;
};

@final struct KeyAuditExternal {
    @key @external uint64 value;
};

typedef string<2> KeyAuditStringPair[2];

@final struct KeyAuditNestedArrays {
    @key KeyAuditStringPair values[2];
};

@final struct KeyAuditBase {
    @id(30) @key uint8 a;
    @id(10) @key uint64 b;
    @id(40) uint8 ignored;
};

@final struct KeyAuditDerived : KeyAuditBase {
    @id(20) uint32 extra;
};

@final union KeyAuditUnion switch (@key long) {
    case 1: uint64 ignored;
    case 2: string other;
};

@final struct SerdataKeyAlignment {
    @key uint8 a;
    @key uint64 b;
    @key uint8 c;
};

@final struct SerdataInner1 {
    @id(2) long i_2;
    @id(1) long i_1;
};

@final struct SerdataInner2 {
    @id(2) @key long i_2;
    @id(1) long i_1;
};

@final struct KeyAuditAggregateArray {
    @key SerdataInner2 values[2];
};

@final struct KeyAuditAggregateSequence {
    @key sequence<SerdataInner2, 2> values;
};

@final struct KeyAuditImplicitArray {
    @key SerdataInner1 values[2];
};

@final struct SerdataOuter {
    @id(3) @key SerdataInner1 o_3;
    @id(2) SerdataInner1 o_2;
    @id(1) @key SerdataInner2 o_1;
};

@final
struct SerdataKeyOrder {
    @key uint8 a;
    uint8 b;
    @key uint64 c;
};

@final
struct SerdataKeyOrderId {
    @id(2) @key uint8 a;
    @id(3) uint8 b;
    @id(1) @key uint64 c;
};

@final @autoid(HASH)
struct SerdataKeyOrderHashId {
    @key uint8 a;       // 0cc175b9
    uint8 b;            // 92eb5ffe
    @key uint64 c;      // 4a8a08f0
};

@appendable
struct SerdataKeyOrderAppendable {
    @id(3) @key uint8 a;
    @id(2) uint8 b;
    @id(1) @key uint64 c;
};

@mutable
struct SerdataKeyOrderMutable {
    @id(3) @key uint8 a;
    @id(2) uint8 b;
    @id(1) @key uint64 c;
};

@final
struct SerdataKeyString {
    @key uint8 a;
    @key string b;
};

@final
struct SerdataKeyStringBounded {
    @key uint8 a;
    @key string<3> b;
};

@appendable
struct SerdataKeyStringAppendable {
    @key uint8 a;
    @key string b;
};

@appendable
struct SerdataKeyStringBoundedAppendable {
    @key uint8 a;
    @key string<3> b;
};

@final
struct SerdataKeyArr {
    @key uint8 a[12];
};

@final
struct SerdataKeyArrStrBounded {
    @key string<2> a[2];
};


// Nested aggregated types

@final
struct SerdataKeyOrderFinalNestedMutable {
    @id(3) @key uint8 x;
    @id(2) uint8 y;
    @id(1) @key SerdataKeyOrderMutable z;
};

@appendable
struct SerdataKeyOrderAppendableNestedMutable {
    @id(3) @key uint8 x;
    @id(2) uint8 y;
    @id(1) @key SerdataKeyOrderMutable z;
};

@mutable
struct SerdataKeyOrderMutableNestedMutable {
    @id(3) @key uint8 x;
    @id(2) uint8 y;
    @id(1) @key SerdataKeyOrderMutable z;
};

@mutable
struct SerdataKeyOrderMutableNestedAppendable {
    @id(3) @key uint8 x;
    @id(2) uint8 y;
    @id(1) @key SerdataKeyOrderAppendable z;
};

@mutable
struct SerdataKeyOrderMutableNestedFinal {
    @id(3) @key uint8 x;
    @id(2) uint8 y;
    @id(1) @key SerdataKeyOrder z;
};

// Implicit key members in nested type

@final @nested
struct SerdataKeyNestedFinalImplicitSubtype {
    @id(3) uint8 x;
    @id(2) uint8 y;
    @id(1) SerdataKeyOrder z;
};

@final
struct SerdataKeyNestedFinalImplicit {
    @id(3) @key SerdataKeyNestedFinalImplicitSubtype d;
    @id(2) SerdataKeyNestedFinalImplicitSubtype e;
    @id(1) @key uint32 f;
};


@final @nested
struct SerdataKeyNestedFinalImplicit2Subtype3 {
    uint8 x;
    uint8 y;
};

@final @nested
struct SerdataKeyNestedFinalImplicit2Subtype2 {
    @key SerdataKeyNestedFinalImplicit2Subtype3 e;
    SerdataKeyNestedFinalImplicit2Subtype3 f;
};

@final @nested
struct SerdataKeyNestedFinalImplicit2Subtype1 {
    SerdataKeyNestedFinalImplicit2Subtype2 c;
    SerdataKeyNestedFinalImplicit2Subtype2 d;
};

@final
struct SerdataKeyNestedFinalImplicit2 {
    @key SerdataKeyNestedFinalImplicit2Subtype1 a;
    SerdataKeyNestedFinalImplicit2Subtype1 b;
};

@mutable @nested
struct SerdataKeyNestedMutableImplicitSubtype {
    @id(3) uint8 x;
    @id(2) uint8 y;
    @id(1) SerdataKeyOrder z;
};

@appendable
struct SerdataKeyNestedMutableImplicit {
    @id(3) @key SerdataKeyNestedMutableImplicitSubtype d;
    @id(2) SerdataKeyNestedMutableImplicitSubtype e;
    @id(1) @key uint32 f;
};

};
